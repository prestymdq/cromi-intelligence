{
  "name": "cromi-intelligence",
  "version": "0.2.0",
  "description": "Extensible, deterministic conversational engine for any application",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "widget",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node examples/demo.mjs",
    "demo:knowledge": "npm run build && node examples/serve-knowledge.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^5.7.284"
  }
}